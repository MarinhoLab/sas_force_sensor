<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sas_force_sensor</name>
  <version>0.0.0</version>
  <description>The sas_force_sensor package for ROS2</description>
  <maintainer email="murilomarinho@ieee.org">Murilo M. Marinho</maintainer>
  <license>LGPLv3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>eigen</depend>
  <depend>sas_core</depend>
  <depend>sas_common</depend>
  <depend>sas_conversions</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pyqt6</exec_depend>
  <exec_depend>python3-pyqtgraph</exec_depend>

  <!-- qdarktheme (imported by sas_force_sensor/gui.py) has no rosdep key;
       install from PyPI: pip install pyqtdarktheme.
       dqrobotics has no rosdep key either; it comes from the DQ Robotics PPA
       and PyPI (https://github.com/marinholab/docker_recipes). -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
